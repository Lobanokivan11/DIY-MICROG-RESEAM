@@ -0,0 +1,48 @@
+name: ci
+
+on:
+  push:
+    tags: ['v*']
+
+jobs:
+  ci:
+    if: ${{ !github.event.deleted }}
+    runs-on: ${{ vars.RUNNER || 'ubuntu-latest' }}
+    container:
+      image: ghcr.io/reseam/ci:2026.10.19
+    env:
+      RELEASE_TOKEN: ${{ secrets.RELEASE_TOKEN || github.token }}
+      AWS_ENDPOINT_URL: ${{ secrets.R2_ENDPOINT }}
+      AWS_REGION: auto
+      AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
+      AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
+      FORGEJO_PACKAGES_TOKEN: ${{ secrets.FORGEJO_PACKAGES_TOKEN }}
+      BUNDLE_SIGNING_KEY_B64: ${{ secrets.BUNDLE_SIGNING_KEY_B64 }}
+      ANDROID_KEYSTORE_B64: ${{ secrets.ANDROID_KEYSTORE_B64 }}
+      RESEAM_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+      RESEAM_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+      RESEAM_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+      GMSCORE_KEYSTORE_B64: ${{ secrets.GMSCORE_KEYSTORE_B64 }}
+      GMSCORE_KEYSTORE_PASSWORD: ${{ secrets.GMSCORE_KEYSTORE_PASSWORD }}
+      GMSCORE_KEY_ALIAS: ${{ secrets.GMSCORE_KEY_ALIAS }}
+      GMSCORE_KEY_PASSWORD: ${{ secrets.GMSCORE_KEY_PASSWORD }}
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+
+      - uses: actions/cache@v6
+        with:
+          path: |
+            /usr/local/cargo/registry
+            /usr/local/cargo/git
+            ~/.gradle/caches
+            ~/.gradle/wrapper
+            ~/.bun/install/cache
+            ~/.npm
+          key: deps-${{ hashFiles('**/Cargo.lock', '**/*.gradle.kts', '**/libs.versions.toml', '**/bun.lock', '**/package-lock.json') }}
+          restore-keys: deps-
+
+      - run: just check
+
+      - run: just release ${{ github.ref_name }}
